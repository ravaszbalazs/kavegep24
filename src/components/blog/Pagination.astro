---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;

function pageUrl(page: number) {
  return page === 1 ? basePath : `${basePath}oldal/${page}/`;
}
---

{totalPages > 1 && (
  <nav class="flex items-center justify-center gap-2 mt-12" aria-label="Lapozó">
    {currentPage > 1 && (
      <a
        href={pageUrl(currentPage - 1)}
        class="w-10 h-10 flex items-center justify-center rounded-full border border-black/20 text-black/60 hover:border-coffee hover:text-coffee transition-colors"
        aria-label="Előző oldal"
      >
        ‹
      </a>
    )}

    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
      <a
        href={pageUrl(page)}
        class:list={[
          'w-10 h-10 flex items-center justify-center rounded-full text-sm font-medium transition-colors',
          page === currentPage
            ? 'bg-coffee text-white'
            : 'border border-black/20 text-black/60 hover:border-coffee hover:text-coffee',
        ]}
        aria-current={page === currentPage ? 'page' : undefined}
      >
        {page}
      </a>
    ))}

    {currentPage < totalPages && (
      <a
        href={pageUrl(currentPage + 1)}
        class="w-10 h-10 flex items-center justify-center rounded-full border border-black/20 text-black/60 hover:border-coffee hover:text-coffee transition-colors"
        aria-label="Következő oldal"
      >
        ›
      </a>
    )}
  </nav>
)}

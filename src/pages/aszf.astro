---
import Base from '../layouts/Base.astro';
import CTA from '../components/ui/CTA.astro';
import { seoData } from '../data/seo';
import { aszfContent } from '../data/aszf';
---

<Base seo={seoData.aszf}>
  <div class="max-w-screen-xl mx-auto px-6 lg:px-8 py-16">
    <div class="reveal mb-12 max-w-3xl">
      <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-yellow mb-4">
        <span class="w-8 h-px bg-yellow"></span>
        Jogi információk
      </span>
      <h1 class="text-4xl lg:text-5xl font-bold text-coffee mb-4">Általános Szerződési <b>Feltételek</b></h1>
      <p class="text-black/50 text-sm">
        Utolsó frissítés: {aszfContent.lastUpdated}
      </p>
    </div>

    <div class="max-w-3xl space-y-10">
      {aszfContent.sections.map((section, i) => (
        <div class:list={['reveal', `reveal-delay-${Math.min(i + 1, 5)}`]}>
          <h2 class="text-xl font-bold text-coffee mb-4">{section.title}</h2>
          <div
            class="text-black/70 leading-relaxed space-y-3 [&_a]:text-coffee [&_a]:underline [&_a]:underline-offset-2 [&_ul]:mt-2 [&_ul]:space-y-1.5 [&_ul]:pl-5 [&_ul]:list-disc [&_ol]:mt-2 [&_ol]:space-y-1.5 [&_ol]:pl-5 [&_ol]:list-decimal"
            set:html={section.content}
          />
        </div>
      ))}
    </div>
  </div>

  <CTA
    title="Kérdése van a <b>szerződési feltételekkel</b> kapcsolatban?"
    text="Vegye fel velünk a kapcsolatot!<br>Szakértőink szívesen eligazítják Önt."
    variant="light"
  />
</Base>

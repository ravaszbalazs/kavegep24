---
import Base from '../layouts/Base.astro';
import type { SeoData } from '../data/seo';

const seo: SeoData = {
  title: '404 – Az oldal nem található | Kávégép24',
  description: 'A keresett oldal nem található.',
  keywords: '',
  ogUrl: 'https://kavegep24.hu/404/',
  ogImage: 'https://kavegep24.hu/images/og-home.jpg',
  robots: 'noindex',
};
---

<Base seo={seo}>
  <div class="min-h-[70vh] flex items-center justify-center px-6">
    <div class="text-center">
      <p class="text-8xl font-bold text-coffee/10 mb-4">404</p>
      <h1 class="text-3xl font-bold text-coffee mb-4">Az oldal nem található</h1>
      <p class="text-black/50 mb-8">A keresett oldal nem létezik vagy áthelyezték.</p>
      <a href="/" class="inline-flex items-center gap-2 bg-coffee text-white px-8 py-4 rounded-full font-semibold hover:bg-coffee/90 transition-colors">
        Vissza a főoldalra
      </a>
    </div>
  </div>
</Base>
